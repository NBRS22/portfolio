# Copy to .env for local development: cp .env.example .env
# On Cloud Run, set these with --set-env-vars / --set-secrets instead (.env is not in the image).

# --- Server -------------------------------------------------------------------
# Bind address and port. Cloud Run injects PORT; use HOST=0.0.0.0 in a container.
HOST=localhost
PORT=7860

# Agent to serve: echo | gemini-live | openai-realtime, or an import path "package.module:Class".
AGENT=gemini-live

# --- Cost and abuse guards ----------------------------------------------------
MAX_SESSION_SECONDS=300
SESSION_GRACE_SECONDS=10
RATE_LIMIT_MAX_SESSIONS=5
RATE_LIMIT_WINDOW_SECONDS=86400
# Proxies that append to X-Forwarded-For (Cloud Run: 1). 0 = use the TCP peer address.
TRUSTED_PROXY_HOPS=1
LOG_LEVEL=INFO

# --- Read by Pipecat ----------------------------------------------------------
# Origins allowed for CORS and WebSocket connections (comma-separated, no trailing slash).
PIPECAT_ALLOWED_ORIGINS=http://localhost:3000

# --- Agent: gemini-live -------------------------------------------------------
GOOGLE_API_KEY=
# GEMINI_MODEL=
# GEMINI_VOICE=Aoede
# GEMINI_LANGUAGE=fr-FR

# --- Agent: openai-realtime ---------------------------------------------------
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=
# OPENAI_REALTIME_VOICE=alloy
