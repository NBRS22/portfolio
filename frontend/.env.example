# Copy to .env.local for local development: cp .env.example .env.local
# On Vercel, set these in Project Settings → Environment Variables instead.

# Public URL of the voice backend (backend/voice_agent). No API key lives on the client.
# Local backend: http://localhost:7860 — Cloud Run: https://<service>-<hash>.<region>.run.app
NEXT_PUBLIC_VOICE_API_URL=http://localhost:7860

# Optional: public URL of the site, for social previews. Defaults to Vercel's production domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
